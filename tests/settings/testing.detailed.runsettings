<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <ConsoleLoggerParameters>verbosity=detailed</ConsoleLoggerParameters>
    <TargetPlatform>x64</TargetPlatform>
    <TargetFrameworkVersion>net9.0</TargetFrameworkVersion>
    <DisableAppDomain>true</DisableAppDomain>
    <DisableParallelization>false</DisableParallelization>
    <MaxCpuCount>0</MaxCpuCount>
    <TestSessionTimeout>60000</TestSessionTimeout>
    <ResultsDirectory>..\..\out\TestResults</ResultsDirectory>
    <EnvironmentVariables>
      <ORG_TEST_MODE>detailed</ORG_TEST_MODE>
      <DOTNET_ENVIRONMENT>Development</DOTNET_ENVIRONMENT>
    </EnvironmentVariables>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <!-- <DataCollector friendlyName="Code Coverage"> -->
        <!-- <Configuration>
          <Format>Coverage</Format>
        </Configuration>
      </DataCollector> -->
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
