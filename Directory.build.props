<?xml version="1.0" encoding="UTF-8"?>
<!-- File: Directory.Build.props
 Common build properties for all projects in the solution -->
<Project>
  <!-- SECTION Directory Information -->
  <PropertyGroup Label="Directory Information">
    <!-- this registers the property `RootDirectory` as the top level dir -->
    <RootDirectory>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)))</RootDirectory>
    <!-- Project directories -->
    <SourceDirectory>$([MSBuild]::NormalizeDirectory($(RootDirectory)src))</SourceDirectory>
    <StageDirectory>$([MSBuild]::NormalizeDirectory($(RootDirectory)stage))</StageDirectory>
    <ArtifactDirectory>$([MSBuild]::NormalizeDirectory($(RootDirectory)out))</ArtifactDirectory>
    <TestsDirectory>$([MSBuild]::NormalizeDirectory($(RootDirectory)tests))</TestsDirectory>
  </PropertyGroup>
  <!-- !SECTION -->
  <!-- SECTION Solution-wide Information -->
  <PropertyGroup Label="Solution Information">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <LangVersion>Latest</LangVersion>
    <OutputObjectDirectory>$([MSBuild]::NormalizeDirectory($(ArtifactDirectory)obj))</OutputObjectDirectory>
    <!-- Ensure that compiler errors emit full paths so that files can be correctly annotated in GitHub. -->
    <GenerateFullPaths>true</GenerateFullPaths>
    <!-- Where to put the results of the build -->
    <BaseOutputPath>$(ArtifactDirectory)</BaseOutputPath>
    <BaseIntermediateOutputPath>$(OutputObjectDirectory)$(MSBuildProjectName)</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Everything will be built in the out directory, but the final product will be in
      stage -->
    <OutDir>$(StageDirectory)$(MSBuildProjectName)</OutDir>
  </PropertyGroup>
  <!-- !SECTION -->
  <!-- SECTION Code Analysis -->
  <PropertyGroup Label="Code Analysis">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>
  <!-- !SECTION -->
</Project>
