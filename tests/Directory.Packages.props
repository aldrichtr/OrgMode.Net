<?xml version="1.0" encoding="UTF-8"?>
<Project>
  <!-- SECTION Import Parent Package File -->
  <PropertyGroup Label="Directory information">
    <ParentDirectory>
      $([System.IO.Directory]::GetParent($(MSBuildThisFileDirectory)'))
    </ParentDirectory>
    <ParentPackageFile>
      $([MSBuild]::GetPathOfFileAbove(
      'Directory.Packages.props',
      $(ParentDirectory)))
    </ParentPackageFile>
  </PropertyGroup>
  <!--  -->
  <ImportGroup>
    <Import Project="$(ParentPackageFile)"/>
  </ImportGroup>
  <!-- !SECTION -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="MSTest"/>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
  </ItemGroup>
</Project>
